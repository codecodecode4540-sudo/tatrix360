{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": { "singularName": "post", "pluralName": "posts", "displayName": "Post", "description": "A Tatrix360 article" },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "content-manager": { "visible": true }, "content-type-builder": { "visible": true } },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "subtitle": { "type": "string" },
    "category": { "type": "relation", "relation": "manyToOne", "target": "api::category.category", "inversedBy": "posts" },
    "tags": { "type": "relation", "relation": "manyToMany", "target": "api::tag.tag", "inversedBy": "posts" },
    "author": { "type": "relation", "relation": "manyToOne", "target": "api::author.author", "inversedBy": "posts" },
    "heroImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "gallery": { "type": "media", "multiple": true, "allowedTypes": ["images"] },
    "postType": { "type": "enumeration", "enum": ["News", "Review", "Guide", "Opinion"], "default": "News", "required": true },
    "content": { "type": "richtext" },
    "seoTitle": { "type": "string" },
    "seoDescription": { "type": "string" },
    "socialShareImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "featured": { "type": "boolean", "default": false },
    "publishedAt": { "type": "datetime" },
    "status": { "type": "enumeration", "enum": ["Draft", "Published", "Archived"], "default": "Draft" },
    "views": { "type": "integer", "default": 0 },
    "affiliate": { "type": "json" }
  }
}
