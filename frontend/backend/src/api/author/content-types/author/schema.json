{
  "kind": "collectionType",
  "collectionName": "authors",
  "info": { "singularName": "author", "pluralName": "authors", "displayName": "Author", "description": "Article authors" },
  "options": { "draftAndPublish": false },
  "pluginOptions": { "content-manager": { "visible": true }, "content-type-builder": { "visible": true } },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "bio": { "type": "text" },
    "avatar": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "role": { "type": "string" },
    "posts": { "type": "relation", "relation": "oneToMany", "target": "api::post.post", "mappedBy": "author" }
  }
}
