{
  "kind": "collectionType",
  "collectionName": "tags",
  "info": { "singularName": "tag", "pluralName": "tags", "displayName": "Tag", "description": "Article tags" },
  "options": { "draftAndPublish": false },
  "pluginOptions": { "content-manager": { "visible": true }, "content-type-builder": { "visible": true } },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "posts": { "type": "relation", "relation": "manyToMany", "target": "api::post.post", "mappedBy": "tags" }
  }
}
