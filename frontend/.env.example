# Frontend (Next.js) environment variables
# Copy to .env and fill in real values. Never commit .env.

# Strapi backend URL
STRAPI_URL=http://localhost:1337

# Strapi API token (Settings → API Tokens in Strapi admin)
STRAPI_API_TOKEN=

# Public site URL (used for canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://tatrix360.com

# Cloudinary cloud name (used by the frontend to build media URLs)
CLOUDINARY_NAME=dhk3fypaz

# Newsletter integration (optional) — brevo | mailchimp | convertkit
NEWSLETTER_PROVIDER=
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=

# Mailchimp-specific datacenter (optional)
MAILCHIMP_DC=

# Contact form webhook (optional) — Slack / Discord / Zapier / Make
CONTACT_WEBHOOK_URL=

# Analytics (optional) — plausible | umami | ga
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
